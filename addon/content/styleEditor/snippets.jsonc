// Banyan style editor snippets (VSCode snippet format).
//
// How to use:
// 1. Each top-level key is the snippet display name.
// 2. `prefix` can be a string or string array.
// 3. `body` can be a string or string array (recommended).
// 4. Use VSCode-style placeholders like ${1:name}, ${2:default} and $0.
// 5. This file is also consumed by Monaco completion in styleEditor.
{
  "INFO: Basic Metadata": {
    "prefix": ["info", "info-basic"],
    "description": "Insert a full INFO block",
    "body": [
      "const INFO = {",
      "  id: \"${1:my-style}\",",
      "  title: \"${2:My Style}\",",
      "  description: \"${3:Describe your style here}\",",
      "  citationType: \"${4|intext-citation,note-citation|}\",",
      "  creator: [{ type: \"author\", name: \"${5:Your Name}\" }],",
      "  tags: [],",
      "  documentation: [],",
      "  license: \"${6:MIT}\",",
      "  updated: \"${7:2026-01-01}\",",
      "};",
      "$0"
    ]
  },
  "INFO: Creator Block": {
    "prefix": ["info-creator", "creator-block"],
    "description": "Insert a creator item for INFO.creator",
    "body": [
      "{",
      "  type: \"${1:author}\",",
      "  name: \"${2:Your Name}\",",
      "  email: \"${3:you@example.com}\",",
      "},",
      "$0"
    ]
  },
  "STYLE_OPTIONS: Basic Options": {
    "prefix": ["style-option", "style-options-basic"],
    "description": "Insert a STYLE_OPTIONS declaration (document-wide parameters)",
    "body": [
      "const STYLE_OPTIONS = [",
      "  {",
      "    id: \"${1:abbrevMode}\",",
      "    kind: \"state\",",
      "    label: \"${2:再次引用}\",",
      "    states: {",
      "      ${3:auto}: \"${4:自动略写}\",",
      "      ${5:full}: \"${6:一律完整}\",",
      "    },",
      "    defaultValue: \"${7:auto}\",",
      "  },",
      "  {",
      "    id: \"${8:maxNames}\",",
      "    kind: \"value\",",
      "    label: \"${9:最多列作者数}\",",
      "    defaultValue: \"${10:3}\",",
      "    description: \"${11:整数；留空按体例默认}\",",
      "    validate: (value) => value === \"\" || /^\\d+$/.test(value) || \"只能填数字\",",
      "  },",
      "];",
      "$0"
    ]
  },
  "CITATION_PARAMS: Basic State": {
    "prefix": ["citation-param", "citation-param-state"],
    "description": "Insert a basic CITATION_PARAMS state parameter",
    "body": [
      "const CITATION_PARAMS = [",
      "  {",
      "    id: \"${1:show-url}\",",
      "    kind: \"state\",",
      "    label: \"${2:Show URL}\",",
      "    defaultValue: ${3:false},",
      "  },",
      "];",
      "$0"
    ]
  },
  "CITATION_PARAMS: Value": {
    "prefix": ["citation-param-value", "citation-value"],
    "description": "Insert a free value parameter for CITATION_PARAMS",
    "body": [
      "{",
      "  id: \"${1:prefix}\",",
      "  kind: \"value\",",
      "  label: \"${2:Prefix}\",",
      "  defaultValue: \"${3:}\",",
      "  presets: [\"${4:参见}\"],",
      "},",
      "$0"
    ]
  },
  "CITATION_PARAMS: Rich Value": {
    "prefix": ["citation-param-richtext", "citation-richtext"],
    "description": "Insert a rich-markup value parameter for CITATION_PARAMS",
    "body": [
      "{",
      "  id: \"${1:comment}\",",
      "  kind: \"value\",",
      "  label: \"${2:Comment}\",",
      "  format: \"rich\",",
      "  defaultValue: \"${3:<em>参见</em>}\",",
      "},",
      "$0"
    ]
  },
  "CITE_PARAMS: Basic State": {
    "prefix": ["cite-param-state", "cite-state"],
    "description": "Insert a state parameter for CITE_PARAMS",
    "body": [
      "{",
      "  id: \"${1:suppress-author}\",",
      "  kind: \"state\",",
      "  label: \"${2:Suppress Author}\",",
      "  defaultValue: ${3:false},",
      "  applicable: (cite) => cite.item.itemType === \"${4:book}\",",
      "},",
      "$0"
    ]
  },
  "CITE_PARAMS: Value": {
    "prefix": ["cite-param-value", "cite-value"],
    "description": "Insert a value parameter for CITE_PARAMS",
    "body": [
      "{",
      "  id: \"${1:locator}\",",
      "  kind: \"value\",",
      "  label: \"${2:Locator}\",",
      "  defaultValue: \"${3:}\",",
      "  applicable: (cite) => cite.item.itemType === \"${4:book}\",",
      "},",
      "$0"
    ]
  },
  "CITE_PARAMS: Forced Value": {
    "prefix": ["cite-param-forced", "cite-forced"],
    "description": "Insert a conditionally forced value parameter",
    "body": [
      "{",
      "  id: \"${1:journalNameForm}\",",
      "  kind: \"state\",",
      "  label: \"${2:报刊名写法}\",",
      "  states: {",
      "    full: \"${3:全称}\",",
      "    abbreviated: \"${4:刊名缩写}\",",
      "  },",
      "  defaultValue: \"${5:full}\",",
      "  forcedValue: (cite) =>",
      "    cite.item.journalAbbreviation ? null : \"${6:full}\",",
      "},",
      "$0"
    ]
  },
  "CITE_PARAMS: List of Values": {
    "prefix": ["cite-param-list", "cite-list"],
    "description": "Insert a list parameter whose fields are value parameters",
    "body": [
      "{",
      "  id: \"${1:pages}\",",
      "  kind: \"list\",",
      "  label: \"${2:多个页码}\",",
      "  min: 1,",
      "  fields: [",
      "    { id: \"start\", kind: \"value\", label: \"${3:起}\", defaultValue: \"\" },",
      "    { id: \"end\", kind: \"value\", label: \"${4:止}\", defaultValue: \"\" },",
      "  ],",
      "},",
      "$0"
    ]
  },
  "ITEM_FIELD_PRESETS: Basic Entry": {
    "prefix": ["preset", "item-field-presets", "quick-mark"],
    "description": "Insert an ITEM_FIELD_PRESETS entry (item context menu \"Quick Marks\")",
    "body": [
      "{",
      "  id: \"${1:classic}\",",
      "  // Menu text; a single plain string, since styles have no locale concept",
      "  label: \"${2:古籍}\",",
      "  // Evaluated in the sandbox; only a strict true counts as visible",
      "  visible: (item) => item.itemType === \"${3:book}\",",
      "  // Written as a real field when valid for the item type, otherwise as an",
      "  // \"extra\" line (values must be non-empty strings)",
      "  fields: { ${4:type}: \"${5:classic}\" },",
      "},",
      "$0"
    ]
  },
  "ITEM_FIELD_VALIDATORS: Basic Checker": {
    "prefix": ["validator", "item-field-validators", "field-check"],
    "description": "Insert an ITEM_FIELD_VALIDATORS checker (item context menu \"Check Fields\")",
    "body": [
      "{",
      "  // Report text; a single plain string, since styles have no locale concept",
      "  description: \"${1:必须填写标题}\",",
      "  // Read-only; return true/false, a string, or an array of strings (may be async)",
      "  check: (item) => ${2:item.title ? true : \"缺少标题\"},",
      "},",
      "$0"
    ]
  },
  "generate: In-text": {
    "prefix": ["gen", "generate-intext"],
    "description": "Insert in-text generate implementation",
    "body": [
      "function generate() {",
      "  const unique = new Map();",
      "  for (const ctx of contexts) {",
      "    for (const cite of ctx.cites) {",
      "      unique.set(cite.item.id, cite.item);",
      "    }",
      "  }",
      "",
      "  const citations = contexts.map((ctx) => ({",
      "    id: ctx.id,",
      "    content: text(\"${1:[1]}\"),",
      "  }));",
      "",
      "  const bibliography = Array.from(unique.values()).map((item) => ({",
      "    id: String(item.id),",
      "    type: \"bibliography-entry\",",
      "    content: text(item.title || item.key),",
      "  }));",
      "",
      "  return { citations, bibliography };",
      "}",
      "$0"
    ]
  },
  "generate: Note": {
    "prefix": ["gen-note", "generate-note"],
    "description": "Insert note-citation generate implementation",
    "body": [
      "function generate() {",
      "  const unique = new Map();",
      "  for (const ctx of contexts) {",
      "    for (const cite of ctx.cites) {",
      "      unique.set(cite.item.id, cite.item);",
      "    }",
      "  }",
      "",
      "  const citations = contexts.map((ctx, index) => ({",
      "    id: ctx.id,",
      "    content: text(String(index + 1)),",
      "    reference: text(`Note ${index + 1}`),",
      "  }));",
      "",
      "  const bibliography = Array.from(unique.values()).map((item) => ({",
      "    id: String(item.id),",
      "    type: \"bibliography-entry\",",
      "    content: text(item.title || item.key),",
      "  }));",
      "",
      "  return { citations, bibliography };",
      "}",
      "$0"
    ]
  }
}
