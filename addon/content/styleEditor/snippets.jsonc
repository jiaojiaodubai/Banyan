// Banyan style editor snippets (VSCode snippet format).
//
// How to use:
// 1. Each top-level key is the snippet display name.
// 2. `prefix` can be a string or string array.
// 3. `body` can be a string or string array (recommended).
// 4. Use VSCode-style placeholders like ${1:name}, ${2:default} and $0.
// 5. This file is also consumed by Monaco completion in styleEditor.
{
  "INFO: Basic Metadata": {
    "prefix": ["info", "info-basic"],
    "description": "Insert a full INFO block",
    "body": [
      "const INFO = {",
      "  id: \"${1:my-style}\",",
      "  title: \"${2:My Style}\",",
      "  description: \"${3:Describe your style here}\",",
      "  citationType: \"${4|intext-citation,note-citation|}\",",
      "  creator: [{ type: \"author\", name: \"${5:Your Name}\" }],",
      "  tags: [],",
      "  documentation: [],",
      "  license: \"${6:MIT}\",",
      "  updated: \"${7:2026-01-01}\",",
      "};",
      "$0"
    ]
  },
  "INFO: Creator Block": {
    "prefix": ["info-creator", "creator-block"],
    "description": "Insert a creator item for INFO.creator",
    "body": [
      "{",
      "  type: \"${1:author}\",",
      "  name: \"${2:Your Name}\",",
      "  email: \"${3:you@example.com}\",",
      "},",
      "$0"
    ]
  },
  "UI: Basic Options": {
    "prefix": ["ui", "ui-basic"],
    "description": "Insert a basic UI declaration",
    "body": [
      "const UI = {",
      "  citation: [",
      "    {",
      "      id: \"${1:show-url}\",",
      "      label: \"${2:Show URL}\",",
      "      type: \"checkbox\",",
      "      value: ${3:false},",
      "    },",
      "  ],",
      "  cite: [],",
      "};",
      "$0"
    ]
  },
  "STYLE_OPTION_CONTROLS: Basic Options": {
    "prefix": ["style-option-control", "style-option-control-basic"],
    "description": "Insert a STYLE_OPTION_CONTROLS declaration (document-wide options)",
    "body": [
      "const STYLE_OPTION_CONTROLS = [",
      "  {",
      "    id: \"${1:abbrevMode}\",",
      "    label: \"${2:再次引用}\",",
      "    type: \"select\",",
      "    value: \"${3:auto}\",",
      "    options: { ${4:auto}: \"${5:自动略写}\", ${6:full}: \"${7:一律完整}\" },",
      "  },",
      "  {",
      "    id: \"${8:maxNames}\",",
      "    label: \"${9:最多列作者数}\",",
      "    type: \"input\",",
      "    value: \"${10:3}\",",
      "    description: \"${11:整数；留空按体例默认}\",",
      "    validate: (value) => value === \"\" || /^\\d+$/.test(value) || \"只能填数字\",",
      "  },",
      "];",
      "$0"
    ]
  },
  "ITEM_FIELD_PRESETS: Basic Entry": {
    "prefix": ["preset", "item-field-presets", "quick-mark"],
    "description": "Insert an ITEM_FIELD_PRESETS entry (item context menu \"Quick Marks\")",
    "body": [
      "{",
      "  id: \"${1:classic}\",",
      "  // Menu text; a single plain string, since styles have no locale concept",
      "  label: \"${2:古籍}\",",
      "  // Evaluated in the sandbox; only a strict true counts as visible",
      "  visible: (item) => item.itemType === \"${3:book}\",",
      "  // Written as a real field when valid for the item type, otherwise as an",
      "  // \"extra\" line (values must be non-empty strings)",
      "  fields: { ${4:type}: \"${5:classic}\" },",
      "},",
      "$0"
    ]
  },
  "UI: Citation Checkbox": {
    "prefix": ["ui-citation-checkbox", "citation-checkbox"],
    "description": "Insert a checkbox component for UI.citation",
    "body": [
      "{",
      "  id: \"${1:show-url}\",",
      "  label: \"${2:Show URL}\",",
      "  type: \"checkbox\",",
      "  value: ${3:false},",
      "},",
      "$0"
    ]
  },
  "ITEM_FIELD_VALIDATORS: Basic Checker": {
    "prefix": ["validator", "item-field-validators", "field-check"],
    "description": "Insert an ITEM_FIELD_VALIDATORS checker (item context menu \"Check Fields\")",
    "body": [
      "{",
      "  // Report text; a single plain string, since styles have no locale concept",
      "  description: \"${1:必须填写标题}\",",
      "  // Read-only; return true/false, a string, an array of strings, or a Promise",
      "  check: (item) => ${2:item.title ? true : \"缺少标题\"},",
      "},",
      "$0"
    ]
  },
  "UI: Citation Select": {
    "prefix": ["ui-citation-select", "citation-select"],
    "description": "Insert a select component for UI.citation",
    "body": [
      "{",
      "  id: \"${1:name-format}\",",
      "  label: \"${2:Name Format}\",",
      "  type: \"select\",",
      "  value: \"${3:full}\",",
      "  options: {",
      "    \"${4:full}\": \"${5:Full Name}\",",
      "    \"${6:abbr}\": \"${7:Abbreviated}\",",
      "  },",
      "},",
      "$0"
    ]
  },
  "UI: Citation Input": {
    "prefix": ["ui-citation-input", "citation-input"],
    "description": "Insert an input component for UI.citation",
    "body": [
      "{",
      "  id: \"${1:prefix}\",",
      "  label: \"${2:Prefix}\",",
      "  type: \"input\",",
      "  value: \"${3:}\",",
      "},",
      "$0"
    ]
  },
  "UI: Cite Checkbox": {
    "prefix": ["ui-cite-checkbox", "cite-checkbox"],
    "description": "Insert a checkbox component for UI.cite",
    "body": [
      "{",
      "  id: \"${1:suppress-author}\",",
      "  label: \"${2:Suppress Author}\",",
      "  type: \"checkbox\",",
      "  value: ${3:false},",
      "  visible: (item) => item.itemType === \"${5:book}\",",
      "},",
      "$0"
    ]
  },
  "UI: Cite Select": {
    "prefix": ["ui-cite-select", "cite-select"],
    "description": "Insert a select component for UI.cite",
    "body": [
      "{",
      "  id: \"${1:page-kind}\",",
      "  label: \"${2:Page Kind}\",",
      "  type: \"select\",",
      "  value: \"${3:page}\",",
      "  options: {",
      "    \"${4:page}\": \"${5:Page}\",",
      "    \"${6:folio}\": \"${7:Folio}\",",
      "  },",
      "  visible: (item) => item.itemType === \"${9:manuscript}\",",
      "},",
      "$0"
    ]
  },
  "UI: Cite Input": {
    "prefix": ["ui-cite-input", "cite-input"],
    "description": "Insert an input component for UI.cite",
    "body": [
      "{",
      "  id: \"${1:locator}\",",
      "  label: \"${2:Locator}\",",
      "  type: \"input\",",
      "  value: \"${3:}\",",
      "  visible: (item) => item.itemType === \"${5:book}\",",
      "},",
      "$0"
    ]
  },
  "generate: In-text": {
    "prefix": ["gen", "generate-intext"],
    "description": "Insert in-text generate implementation",
    "body": [
      "function generate() {",
      "  const unique = new Map();",
      "  for (const ctx of contexts) {",
      "    for (const cite of ctx.cites) {",
      "      unique.set(cite.item.id, cite.item);",
      "    }",
      "  }",
      "",
      "  const citations = contexts.map((ctx) => ({",
      "    id: ctx.id,",
      "    content: text(\"${1:[1]}\"),",
      "  }));",
      "",
      "  const bibliography = Array.from(unique.values()).map((item) => ({",
      "    id: String(item.id),",
      "    type: \"bibliography-entry\",",
      "    content: text(item.title || item.key),",
      "  }));",
      "",
      "  return { citations, bibliography };",
      "}",
      "$0"
    ]
  },
  "generate: Note": {
    "prefix": ["gen-note", "generate-note"],
    "description": "Insert note-citation generate implementation",
    "body": [
      "function generate() {",
      "  const unique = new Map();",
      "  for (const ctx of contexts) {",
      "    for (const cite of ctx.cites) {",
      "      unique.set(cite.item.id, cite.item);",
      "    }",
      "  }",
      "",
      "  const citations = contexts.map((ctx, index) => ({",
      "    id: ctx.id,",
      "    content: text(String(index + 1)),",
      "    reference: text(`Note ${index + 1}`),",
      "  }));",
      "",
      "  const bibliography = Array.from(unique.values()).map((item) => ({",
      "    id: String(item.id),",
      "    type: \"bibliography-entry\",",
      "    content: text(item.title || item.key),",
      "  }));",
      "",
      "  return { citations, bibliography };",
      "}",
      "$0"
    ]
  }
}
