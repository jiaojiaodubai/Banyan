prefs-title = 榕树
prefs-citation-dialog-title = 引注窗口
prefs-citation-dialog-initial-collection-mode = 打开时默认选中：
prefs-citation-dialog-initial-collection-mode-main-library =
    .label = 主文库
prefs-citation-dialog-initial-collection-mode-follow-app-selection =
    .label = 和客户端一致
prefs-citation-dialog-initial-collection-mode-last-selected =
    .label = 上一次选中的分类
prefs-citation-dialog-initial-collection-mode-help = 选择“主文库”时，会显示该文库中的全部条目；选择“和客户端一致”时，会选中客户端当前选中的文库或分类，若无法恢复则回退到主文库；选择“上一次选中的分类”时，会恢复到上次在引注窗口中选中的文库或分类。
prefs-item-menu-title = 条目菜单
prefs-item-menu-label = 采用的样式：
prefs-item-menu-help = 有些样式能在条目上下文菜单中显示“快捷标记”或“检查字段”菜单项，可以在下面选择由哪个样式提供这两个菜单项。
prefs-item-menu-option-last = 上次使用
prefs-item-menu-option-disabled = 禁用
prefs-item-list-title = 条目列表
prefs-extra-value-column-label = 额外字段：extra 键名
prefs-extra-value-column-placeholder =
    .placeholder = 例如 Type
prefs-extra-value-column-help = 在条目列表里以单独的列显示某个 extra 键的值。填好键名后，到条目列表表头右键的“列设置”里勾选“额外字段：<键名>”即可显示；留空则不提供该列。列只是显示用途，不会改动条目数据。
prefs-style-manager-title = 样式管理器
import-style = 导入样式
delete-style = 删除样式
