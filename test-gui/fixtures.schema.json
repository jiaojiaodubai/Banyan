{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiaojiaodubai/Banyan/test-gui/fixtures.schema.json",
  "title": "Banyan manual GUI fixtures",
  "type": "object",
  "required": ["version", "collection", "subcollections", "items"],
  "properties": {
    "version": { "const": 1 },
    "collection": {
      "type": "object",
      "required": ["key", "name"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[23456789ABCDEFGHIJKLMNPQRSTUVWXYZ]{8}$"
        },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "subcollections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "parent"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[23456789ABCDEFGHIJKLMNPQRSTUVWXYZ]{8}$"
          },
          "name": { "type": "string", "minLength": 1 },
          "parent": {
            "type": "string",
            "pattern": "^[23456789ABCDEFGHIJKLMNPQRSTUVWXYZ]{8}$"
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["citationKey", "itemType", "collections", "title"],
        "properties": {
          "citationKey": { "type": "string", "minLength": 1 },
          "itemType": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "collections": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "creators": { "type": "array", "items": { "type": "object" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "relations": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
