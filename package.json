{
  "name": "banyan",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.24.0",
  "description": "Fully customize citation styles using JavaScript in Zotero",
  "config": {
    "addonName": "Banyan",
    "addonID": "banyan@jiaojiaodubai",
    "addonRef": "banyan",
    "addonInstance": "Banyan",
    "prefsPrefix": "extensions.zotero.banyan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaojiaodubai/banyan.git"
  },
  "author": "jiaojiaodubai",
  "bugs": {
    "url": "https://github.com/jiaojiaodubai/banyan/issues"
  },
  "homepage": "https://github.com/jiaojiaodubai/banyan#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "pnpm gen:style-editor-dts && pnpm gen:wps-addin-manifest && pnpm gen:presets-manifest && zotero-plugin serve",
    "build": "pnpm gen:style-editor-dts && pnpm gen:wps-addin-manifest && pnpm gen:presets-manifest && zotero-plugin build && tsc --noEmit",
    "gen:i10n": "node scripts/genFluentTypings.mjs",
    "gen:style-editor-dts": "node scripts/genStyleEditorDTS.mjs",
    "gen:wps-addin-manifest": "node scripts/genWPSAddinManifest.mjs",
    "gen:presets-manifest": "node scripts/genPresetsManifest.mjs",
    "lint:check": "prettier --check . && eslint . && eslint --config addon/content/styleEditor/eslint.config.mjs addon/content/styleEditor",
    "lint:fix": "prettier --write . && eslint . --fix && eslint --config addon/content/styleEditor/eslint.config.mjs addon/content/styleEditor --fix",
    "release": "zotero-plugin release",
    "release:prepare": "pnpm update && pnpm submodules:update && pnpm integrations:build && pnpm build && pnpm changelog",
    "changelog": "changelogen --output CHANGELOG.md",
    "integrations:build": "node scripts/build-integrations.mjs",
    "submodules:init": "git submodule update --init --recursive",
    "submodules:update": "pnpm submodules:init && git submodule update --remote --recursive",
    "test": "node scripts/runTestWithLog.mjs",
    "test:node": "node --import tsx ./node_modules/mocha/bin/mocha.js --timeout 10000 \"tests-node/**/*.test.ts\"",
    "test:scaffold": "zotero-plugin test",
    "update-deps": "pnpm update"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.1.0-beta.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^5.3.3",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.5",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      },
      {
        "files": [
          "addon/content/styleEditor/snippets.jsonc"
        ],
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  }
}
